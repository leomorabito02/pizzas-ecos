# Database Configuration
# Para Neon (PostgreSQL), usa el connection string proveído en su dashboard
DATABASE_URL=postgres://user:password@ep-cold-shadow-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret para autenticación
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS - Origins permitidos (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://ecos-ventas-pizzas.netlify.app,https://tu-dominio.com

# Port
PORT=8080

# Debug mode
DEBUG=false

# Field-level encryption — AES-256-GCM (32 bytes en hex = 64 chars)
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# HMAC para columnas de búsqueda exacta (32 bytes en hex = 64 chars)
# Generar con: openssl rand -hex 32
HMAC_KEY=your-64-char-hex-hmac-key-here
